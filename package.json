{
  "name": "sholatku",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "build:mobile": "vite build --config vite.mobile.config.ts --mode mobile",
    "build:mobile:staging": "vite build --config vite.mobile.config.ts --mode mobile",
    "build:mobile:internal": "vite build --config vite.mobile.config.ts --mode mobile-internal",
    "build:mobile:production": "vite build --config vite.mobile.config.ts --mode mobile-production",
    "dev:mobile": "vite --config vite.mobile.config.ts --mode mobile",
    "preview:mobile": "vite preview --config vite.mobile.config.ts --host 127.0.0.1",
    "verify:mobile-build": "node scripts/verify-mobile-build.mjs",
    "test:e2e:mobile": "npm run build:mobile && npm run verify:mobile-build && playwright test --config playwright.mobile.config.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/local-notifications": "^8.3.1",
    "idb": "^8.0.3",
    "lucide-react": "^0.475.0",
    "next": "15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@playwright/test": "^1.62.1",
    "@serwist/next": "^9.5.12",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.25",
    "fake-indexeddb": "^6.2.5",
    "postcss": "8.5.26",
    "serwist": "^9.5.12",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vitest": "^3.0.5"
  },
  "overrides": {
    "postcss": "$postcss",
    "@serwist/next": {
      "browserslist": "4.28.8"
    }
  }
}
