<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetRoot">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/widget_background</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- Prayer names arrive as bitmaps in Plus Jakarta Sans (see WidgetTextRenderer). -->
    <style name="WidgetDisplayImage">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:adjustViewBounds">true</item>
        <item name="android:scaleType">fitStart</item>
    </style>

    <!-- Chronometer cannot take a bundled font in RemoteViews: thin system numerals, fixed-width digits. -->
    <style name="WidgetCountdown">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_text</item>
    </style>

    <style name="WidgetSecondary">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_text_secondary</item>
    </style>

    <style name="WidgetTimelineCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">12dp</item>
        <item name="android:layout_weight">1</item>
    </style>
    <style name="WidgetTimelineTrack">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">2dp</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <style name="WidgetTimelineSegment">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@color/widget_line_off</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="WidgetTimelineDot">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:src">@drawable/widget_dot_upcoming</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <!-- Fixed height lets autosize shrink a time instead of clipping it on narrow or large-font screens. -->
    <style name="WidgetTimelineTime" parent="WidgetSecondary">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">8sp</item>
        <item name="android:autoSizeMaxTextSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:text">--:--</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- 4x1 day strip: one column per prayer; the next one gets widget_pill_next as background. -->
    <style name="WidgetPrayerColumn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>
    <!-- One fixed size for all five labels: per-view autosize shrank only the long names and looked uneven. -->
    <style name="WidgetPrayerLabel" parent="WidgetSecondary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">true</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textSize">8sp</item>
    </style>
    <!-- Stroke icons tinted per state by the updater (setColorFilter). -->
    <style name="WidgetPrayerIcon">
        <item name="android:layout_width">14dp</item>
        <item name="android:layout_height">14dp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <!-- Times are bitmaps in Plus Jakarta Sans, like the prayer name; fitCenter shrinks them on narrow screens. -->
    <style name="WidgetPrayerTimeImage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">15dp</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="WidgetMessage" parent="WidgetSecondary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:text">@string/widget_stale</item>
        <item name="android:textSize">12sp</item>
        <item name="android:visibility">gone</item>
    </style>
</resources>
