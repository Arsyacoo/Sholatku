<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    style="@style/WidgetRoot"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <!-- The next prayer's time is read from its highlighted column. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_next_name"
                style="@style/WidgetPrayerName"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/widget_next_arabic"
                style="@style/WidgetPrayerArabic"
                android:layout_marginStart="5dp"
                android:textSize="12sp" />
        </LinearLayout>
        <Chronometer
            android:id="@+id/widget_countdown"
            style="@style/WidgetCountdown"
            android:layout_width="64dp"
            android:layout_height="20dp"
            android:layout_marginTop="3dp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeTextType="uniform"
            android:maxLines="1" />
    </LinearLayout>

    <ImageView
        android:importantForAccessibility="no"
        android:layout_width="1dp"
        android:layout_height="30dp"
        android:layout_marginHorizontal="8dp"
        android:background="@color/widget_hairline" />

    <include
        layout="@layout/widget_prayer_columns"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />
    <TextView
        android:id="@+id/widget_message"
        style="@style/WidgetMessage"
        android:layout_width="0dp"
        android:layout_weight="1" />
</LinearLayout>
