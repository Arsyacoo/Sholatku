<?xml version="1.0" encoding="utf-8"?>
<!-- 4x1: the next prayer and its countdown on the left, the whole day on the right with the next prayer in a pill. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    style="@style/WidgetRoot"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="6dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <ImageView android:id="@+id/widget_next_name" style="@style/WidgetDisplayImage" />
        <Chronometer
            android:id="@+id/widget_countdown"
            style="@style/WidgetCountdown"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/widget_gold_soft"
            android:textSize="13sp" />
        <TextView android:id="@+id/widget_message" style="@style/WidgetMessage" android:layout_marginTop="2dp" />
    </LinearLayout>

    <ImageView
        android:layout_width="1dp"
        android:layout_height="32dp"
        android:layout_marginHorizontal="12dp"
        android:importantForAccessibility="no"
        android:src="@color/widget_line_off" />

    <LinearLayout
        android:id="@+id/widget_schedule"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal">
        <LinearLayout android:id="@+id/widget_col_0" style="@style/WidgetPrayerColumn">
            <ImageView android:id="@+id/widget_icon_0" style="@style/WidgetPrayerIcon" android:src="@drawable/widget_ic_subuh" />
            <ImageView android:id="@+id/widget_time_img_0" style="@style/WidgetPrayerTimeImage" />
            <TextView android:id="@+id/widget_label_0" style="@style/WidgetPrayerLabel" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_col_1" style="@style/WidgetPrayerColumn">
            <ImageView android:id="@+id/widget_icon_1" style="@style/WidgetPrayerIcon" android:src="@drawable/widget_ic_dzuhur" />
            <ImageView android:id="@+id/widget_time_img_1" style="@style/WidgetPrayerTimeImage" />
            <TextView android:id="@+id/widget_label_1" style="@style/WidgetPrayerLabel" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_col_2" style="@style/WidgetPrayerColumn">
            <ImageView android:id="@+id/widget_icon_2" style="@style/WidgetPrayerIcon" android:src="@drawable/widget_ic_ashar" />
            <ImageView android:id="@+id/widget_time_img_2" style="@style/WidgetPrayerTimeImage" />
            <TextView android:id="@+id/widget_label_2" style="@style/WidgetPrayerLabel" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_col_3" style="@style/WidgetPrayerColumn">
            <ImageView android:id="@+id/widget_icon_3" style="@style/WidgetPrayerIcon" android:src="@drawable/widget_ic_maghrib" />
            <ImageView android:id="@+id/widget_time_img_3" style="@style/WidgetPrayerTimeImage" />
            <TextView android:id="@+id/widget_label_3" style="@style/WidgetPrayerLabel" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_col_4" style="@style/WidgetPrayerColumn">
            <ImageView android:id="@+id/widget_icon_4" style="@style/WidgetPrayerIcon" android:src="@drawable/widget_ic_isya" />
            <ImageView android:id="@+id/widget_time_img_4" style="@style/WidgetPrayerTimeImage" />
            <TextView android:id="@+id/widget_label_4" style="@style/WidgetPrayerLabel" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
