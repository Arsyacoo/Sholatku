<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    style="@style/WidgetRoot"
    android:paddingHorizontal="18dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView android:id="@+id/widget_next_name" style="@style/WidgetDisplayImage" />
        <TextView
            android:id="@+id/widget_next_time"
            style="@style/WidgetSecondary"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="--:--"
            android:textSize="12sp" />
        <Chronometer
            android:id="@+id/widget_countdown"
            style="@style/WidgetCountdown"
            android:textSize="22sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_schedule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">
        <include layout="@layout/widget_prayer_timeline" />
    </LinearLayout>

    <TextView android:id="@+id/widget_message" style="@style/WidgetMessage" />
</LinearLayout>
