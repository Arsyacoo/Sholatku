<?xml version="1.0" encoding="utf-8"?>
<!-- One prayer, room to breathe: the full five-time list lives in the 4x2 widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    style="@style/WidgetRoot"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="10dp"
    android:paddingVertical="5dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView android:id="@+id/widget_next_name" style="@style/WidgetDisplayImage" />
            <ImageView
                android:id="@+id/widget_next_arabic"
                style="@style/WidgetDisplayImage"
                android:layout_marginStart="10dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                style="@style/WidgetIcon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_widget_clock" />
            <TextView
                android:id="@+id/widget_next_time_long"
                style="@style/WidgetSecondary"
                android:layout_marginStart="5dp"
                android:text="--:--"
                android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/widget_message" style="@style/WidgetMessage" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/widget_panel"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp">
        <Chronometer
            android:id="@+id/widget_countdown"
            style="@style/WidgetCountdown"
            android:textSize="24sp" />
    </FrameLayout>
</LinearLayout>
