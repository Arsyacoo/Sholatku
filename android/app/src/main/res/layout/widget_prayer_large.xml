<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    style="@style/WidgetRoot"
    android:paddingHorizontal="18dp"
    android:paddingVertical="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <!-- The name bitmap keeps its natural size; stretching it would blur the text. -->
        <ImageView android:id="@+id/widget_next_name" style="@style/WidgetDisplayImage" />
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <Chronometer
            android:id="@+id/widget_countdown"
            style="@style/WidgetCountdown"
            android:textSize="30sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_header"
        style="@style/WidgetSecondary"
        android:layout_width="match_parent"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:textSize="12sp" />

    <!-- Same day strip as 4x1, one size up: icon, time in Plus Jakarta Sans, name; the next prayer in a pill. -->
    <LinearLayout
        android:id="@+id/widget_schedule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">
        <LinearLayout android:id="@+id/widget_col_0" style="@style/WidgetPrayerColumn" android:paddingTop="7dp" android:paddingBottom="6dp">
            <ImageView android:id="@+id/widget_icon_0" style="@style/WidgetPrayerIcon" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/widget_ic_subuh" />
            <ImageView android:id="@+id/widget_time_img_0" style="@style/WidgetPrayerTimeImage" android:layout_height="18dp" android:layout_marginTop="4dp" />
            <TextView android:id="@+id/widget_label_0" style="@style/WidgetPrayerLabel" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_col_1" style="@style/WidgetPrayerColumn" android:paddingTop="7dp" android:paddingBottom="6dp">
            <ImageView android:id="@+id/widget_icon_1" style="@style/WidgetPrayerIcon" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/widget_ic_dzuhur" />
            <ImageView android:id="@+id/widget_time_img_1" style="@style/WidgetPrayerTimeImage" android:layout_height="18dp" android:layout_marginTop="4dp" />
            <TextView android:id="@+id/widget_label_1" style="@style/WidgetPrayerLabel" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_col_2" style="@style/WidgetPrayerColumn" android:paddingTop="7dp" android:paddingBottom="6dp">
            <ImageView android:id="@+id/widget_icon_2" style="@style/WidgetPrayerIcon" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/widget_ic_ashar" />
            <ImageView android:id="@+id/widget_time_img_2" style="@style/WidgetPrayerTimeImage" android:layout_height="18dp" android:layout_marginTop="4dp" />
            <TextView android:id="@+id/widget_label_2" style="@style/WidgetPrayerLabel" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_col_3" style="@style/WidgetPrayerColumn" android:paddingTop="7dp" android:paddingBottom="6dp">
            <ImageView android:id="@+id/widget_icon_3" style="@style/WidgetPrayerIcon" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/widget_ic_maghrib" />
            <ImageView android:id="@+id/widget_time_img_3" style="@style/WidgetPrayerTimeImage" android:layout_height="18dp" android:layout_marginTop="4dp" />
            <TextView android:id="@+id/widget_label_3" style="@style/WidgetPrayerLabel" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_col_4" style="@style/WidgetPrayerColumn" android:paddingTop="7dp" android:paddingBottom="6dp">
            <ImageView android:id="@+id/widget_icon_4" style="@style/WidgetPrayerIcon" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/widget_ic_isya" />
            <ImageView android:id="@+id/widget_time_img_4" style="@style/WidgetPrayerTimeImage" android:layout_height="18dp" android:layout_marginTop="4dp" />
            <TextView android:id="@+id/widget_label_4" style="@style/WidgetPrayerLabel" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/widget_message" style="@style/WidgetMessage" />
</LinearLayout>
