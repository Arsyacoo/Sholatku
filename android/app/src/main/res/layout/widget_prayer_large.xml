<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    style="@style/WidgetRoot"
    android:paddingHorizontal="18dp"
    android:paddingVertical="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <!-- The name bitmap keeps its natural size; stretching it would blur the text. -->
        <ImageView android:id="@+id/widget_next_name" style="@style/WidgetDisplayImage" />
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <Chronometer
            android:id="@+id/widget_countdown"
            style="@style/WidgetCountdown"
            android:textSize="30sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_header"
        style="@style/WidgetSecondary"
        android:layout_width="match_parent"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/widget_schedule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">
        <include layout="@layout/widget_prayer_timeline" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <TextView android:id="@+id/widget_time_0" style="@style/WidgetTimelineTime" />
            <TextView android:id="@+id/widget_time_1" style="@style/WidgetTimelineTime" />
            <TextView android:id="@+id/widget_time_2" style="@style/WidgetTimelineTime" />
            <TextView android:id="@+id/widget_time_3" style="@style/WidgetTimelineTime" />
            <TextView android:id="@+id/widget_time_4" style="@style/WidgetTimelineTime" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/widget_message" style="@style/WidgetMessage" />
</LinearLayout>
