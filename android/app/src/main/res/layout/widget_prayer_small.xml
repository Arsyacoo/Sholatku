<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    style="@style/WidgetRoot"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/widget_next_label"
        style="@style/WidgetDisplayImage"
        android:layout_width="match_parent"
        android:layout_height="18dp" />

    <!-- Display numerals in dp: on a 2x1 a scaled-up countdown would lose its seconds. -->
    <Chronometer
        android:id="@+id/widget_countdown"
        style="@style/WidgetCountdown"
        android:layout_marginTop="2dp"
        android:textSize="24dp" />

    <TextView android:id="@+id/widget_message" style="@style/WidgetMessage" />
</LinearLayout>
