<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="@color/widget_bg_center"
                android:endColor="@color/widget_bg_end"
                android:startColor="@color/widget_bg_start" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="1"
                android:centerY="1"
                android:endColor="@color/widget_transparent"
                android:gradientRadius="150dp"
                android:startColor="@color/widget_glow_gold"
                android:type="radial" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0"
                android:centerY="0"
                android:endColor="@color/widget_transparent"
                android:gradientRadius="110dp"
                android:startColor="@color/widget_glow_teal"
                android:type="radial" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/widget_hairline" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
