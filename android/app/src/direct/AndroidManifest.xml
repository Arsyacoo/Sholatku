<?xml version="1.0" encoding="utf-8"?>
<!-- Direct (GitHub) builds only: the app downloads its own release APK and opens the system installer.
     Kept out of the main manifest so a future Play build does not request it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
